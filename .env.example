# Copy to .env and fill in. Never commit .env.

# NEAR testnet (escrow, OutLayer tests)
# Cloud sessions: NEAR_ACCOUNT_ID and NEAR_PRIVATE_KEY come in as real env vars.
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
ESCROW_CONTRACT_ID=
OUTLAYER_CONTRACT_ID=outlayer.testnet

# Paystack TEST MODE only (sk_test_...). Live keys are not allowed.
# Cloud sessions: NOT an env var. The agent proxy injects the key into every request to
# api.paystack.co (checked 2026-11-01). Scripts must accept an empty value there and still call
# the API. Local runs: set it here.
PAYSTACK_SECRET_KEY=

# NEAR mainnet dev account for NEAR Intents (tiny amounts only, see DECISIONS D-004)
MAINNET_ACCOUNT_ID=
MAINNET_PRIVATE_KEY=
ONECLICK_API_KEY=
BASE_RECIPIENT_ADDRESS=

# pawaPay SANDBOX only, for sell-flow payout tests (DECISIONS D-011). Never a production token.
# Cloud sessions: the agent proxy injects the token for api.sandbox.pawapay.io (network secret).
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
